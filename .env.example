# Copy to .env and edit:   Copy-Item .env.example .env
# Every value here can also be overridden by a CLI flag on generate.py.

# ---------------------------------------------------------------------------
# Model weight cache  --  IMPORTANT
# ---------------------------------------------------------------------------
# TripoSR weights are ~1.7 GB. This project lives inside OneDrive, so leaving
# the cache in the project folder would sync gigabytes to the cloud.
# Keep it on a local path outside OneDrive.
HF_HOME=C:/ai/hf-cache

# Only needed for gated repos. TripoSR and tencent/Hunyuan3D-2.1 are both
# public, so this can stay blank. scripts/modal_app/ reads it from here and forwards it
# to the container when set, which only raises the HuggingFace download rate
# limit - useful if you rebuild the weight cache repeatedly.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# triposr    - runs on your 4 GB RTX 3050. The only locally-viable option.
# hunyuan3d  - needs ~6 GB (shape) / ~16 GB (shape+texture) and a compiled
#              CUDA extension. Cloud GPU only; see README.
#
# Hunyuan3D-2.1 is not selectable here at all - it runs on Modal, out of
# scripts/modal_app/, with its own flags. See scripts/modal_app/README.md.
MODEL_BACKEND=triposr

# ---------------------------------------------------------------------------
# Device / memory  --  tuned for 4 GB VRAM
# ---------------------------------------------------------------------------
DEVICE=auto                 # auto | cuda | cpu
HALF_PRECISION=false        # true halves weight memory; slight quality loss

# Lower this first if you hit CUDA out-of-memory. 8192 is upstream's default
# (~6 GB). 4096 is the safe starting point on a 4 GB card. Try 2048 / 1024 next.
CHUNK_SIZE=4096

# Marching-cubes grid. 256 is the standard. 320/384 gives finer geometry but
# costs memory quadratically-ish; drop to 192 if 256 will not fit.
MC_RESOLUTION=256

# ---------------------------------------------------------------------------
# Input preprocessing
# ---------------------------------------------------------------------------
# These are single-object reconstructors. Background removal is not optional in
# practice - leaving it off noticeably degrades output on real photos.
REMOVE_BACKGROUND=true
FOREGROUND_RATIO=0.85       # how much of the frame the object fills, 0.5-1.0
REMBG_MODEL=u2net           # u2net | isnet-general-use | silueta

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
OUTPUT_DIR=outputs
OUTPUT_FORMAT=glb           # glb | obj
BAKE_TEXTURE=true           # true -> UV-mapped texture; false -> vertex colours
TEXTURE_RESOLUTION=2048

# Reverse triangle winding if a mesh renders inside-out. This used to default to
# true to paper over a bug in the PyMCubes shim, which returned vertices in
# array-index order where torchmcubes returns them reversed. TripoSR's
# v_pos[..., [2, 1, 0]] then reflected the mesh instead of correcting it, which
# both mirrored the geometry and inverted the normals. compat.py now matches the
# torchmcubes convention, so leave this off.
FLIP_FACES=false

# ---------------------------------------------------------------------------
# API  --  uvicorn src.main:app
# ---------------------------------------------------------------------------
# The generation endpoints spend GPU money, so they are not open to the
# internet. Set a shared secret and give the same value to the viewer as
# MODAL_TOKEN; every request must carry it as X-Dioramic-Token.
#     DIORAMIC_TOKEN=$(openssl rand -hex 32)
# Blank disables the check, which is only ever right on localhost.
DIORAMIC_TOKEN=

API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated browser origins allowed to call this directly. Leave blank:
# the viewer reaches the API from its Next.js server, which is not a browser
# and sends no Origin, so the normal deployment needs no CORS at all.
API_CORS_ORIGINS=

# The deployed Modal app holding the GPU, addressed by name.
#     modal deploy scripts/modal_app/hunyuan3d.py
MODAL_APP=dioramic-hunyuan3d
MODAL_CLASS=Hunyuan3D

# ---------------------------------------------------------------------------
# Scene assembly (Blender)
# ---------------------------------------------------------------------------
# Full path to blender.exe. Blender bundles its own Python, so it is driven as
# a subprocess and never imported - this venv cannot see bpy and vice versa.
# Leave blank to fall back to `blender` on PATH.
BLENDER_EXE=
