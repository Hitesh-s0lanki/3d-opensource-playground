# --- Python -----------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# --- secrets ----------------------------------------------------------------
.env

# --- generated data ---------------------------------------------------------
# The app keeps nothing on disk - runs live in Neon, binaries in blob storage.
# The rule below only exists because the local Python CLI still writes meshes
# somewhere (OUTPUT_DIR, default outputs/), and those must never be committed.
outputs/
.cache/

# Upstream projects ship as repositories, not packages; backends/base.py clones
# them here on first run.
vendor/

# --- model and mesh binaries ------------------------------------------------
*.glb

# ...except the meshes the landing page ships. These are site assets, not build
# output: the showcase loads them in the browser, so they have to be in the
# deploy. Listed one by one rather than by folder so that a mesh dropped into
# `public/` while working stays ignored - the rule above is what keeps 20 MB of
# generated output from being committed by reflex, and it should keep working.
!frontend/public/showcase/raphael.glb
!frontend/public/showcase/orc-bust.glb
!frontend/public/showcase/doraemon.glb
!frontend/public/samples/tin-robot.glb
*.obj
*.ckpt
*.safetensors

# --- tooling scratch --------------------------------------------------------
.playwright/

# --- JavaScript -------------------------------------------------------------
# frontend/.gitignore covers these as well, but a .gitignore only governs its
# own directory downwards, so those rules vanish the moment the app is moved or
# a second one appears. Renaming web/ to frontend/ put 40k node_modules files in
# `git status` for exactly that reason. These are rooted nowhere, so they hold
# wherever the app lives.
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts
.env.local
