# Neon Postgres connection string, from https://console.neon.tech
# (Project -> Connect -> "Connection string", the pooled one is fine).
# Copy this file to .env and fill it in, then run:  npm run db:push
#
# Optional: without it the app runs file-only - no catalog, no job history.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
