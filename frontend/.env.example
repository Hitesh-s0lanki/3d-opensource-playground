# Copy to .env and fill in:   Copy-Item .env.example .env
#
# Every value below is required except the last two - the app stores nothing on
# disk, so there is no file-only mode to fall back to any more. drizzle-kit
# reads this same .env, which is why it is .env and not .env.local.

# ---------------------------------------------------------------------------
# Neon Postgres  --  the catalog
# ---------------------------------------------------------------------------
# From https://console.neon.tech (Project -> Connect -> connection string; the
# pooled one is fine). Holds every run, job and blob key, all keyed by user.
# After setting it:  npm run db:migrate
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# ---------------------------------------------------------------------------
# Clerk  --  who each row belongs to
# ---------------------------------------------------------------------------
# From https://dashboard.clerk.com -> your app -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# ---------------------------------------------------------------------------
# Vercel Blob  --  photos and meshes
# ---------------------------------------------------------------------------
# From the Vercel dashboard -> Storage -> your Blob store -> Tokens, or
# `vercel env pull` if the project is linked. Blobs are written private and
# read back only through /api/files, which checks the caller owns the key.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ---------------------------------------------------------------------------
# Modal  --  the GPU that actually generates
# ---------------------------------------------------------------------------
# The URL printed by `modal deploy scripts/modal_app/hunyuan3d.py` for the
# `api` function - one host, with /generate and /result under it.
MODAL_ENDPOINT="https://YOURNAME--dioramic-hunyuan3d-api.modal.run"

# Must equal DIORAMIC_TOKEN in the Modal secret, created once with:
#   modal secret create dioramic-api-token DIORAMIC_TOKEN=$(openssl rand -hex 32)
# Without it the endpoint would let anyone spend your GPU credit.
MODAL_TOKEN=""

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Public origin of the deployed app, used to resolve the og:image to an
# absolute URL. Optional locally; set it in the deployed environment.
NEXT_PUBLIC_SITE_URL="https://example.com"
